@startuml
actor Client
participant "Serveur Flask" as Server
database "Base de données" as DB

Client -> Server : Envoyer demande dépôt commande (ID client + détails commande)
Server -> DB : Vérifier existence client par ID
DB --> Server : Retour infos client (valide/invalide)
alt Client valide
    Server -> Server : Valider la commande
    Server -> DB : Enregistrer la commande
    DB --> Server : Confirmation enregistrement
    Server --> Client : Confirmer dépôt commande réussi
else Client invalide
    Server --> Client : Erreur : Client non reconnu
end
@enduml
