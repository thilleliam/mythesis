try:
    # Créer et insérer chaque équipement
    for equipement_data in donnees_equipements:
        equipement = TransfererEquipement(
            id_client=equipement_data["id_client"],
            volet=equipement_data["volet"],
            designation_equipement=equipement_data["designation_equipement"],
            modalite_transport=equipement_data["modalite_transport"],
            total_equipements=equipement_data["total_equipements"],
            douze_semaines_avant=equipement_data.get("douze_semaines_avant"),
            onze_semaines_avant=equipement_data.get("onze_semaines_avant"),
            dix_semaines_avant=equipement_data.get("dix_semaines_avant"),
            neuf_semaines_avant=equipement_data.get("neuf_semaines_avant"),
            huit_semaines_avant=equipement_data.get("huit_semaines_avant"),
            sept_semaines_avant=equipement_data.get("sept_semaines_avant"),
            six_semaines_avant=equipement_data.get("six_semaines_avant"),
            cinq_semaines_avant=equipement_data.get("cinq_semaines_avant"),
            quatre_semaines_avant=equipement_data.get("quatre_semaines_avant"),
            trois_semaines_avant=equipement_data.get("trois_semaines_avant"),
            deux_semaines_avant=equipement_data.get("deux_semaines_avant"),
            un_semaines_avant=equipement_data.get("un_semaines_avant"),
            zero_semaines_avant=equipement_data.get("zero_semaines_avant")
        )
        session.add(equipement)
    
    # Valider les changements
    session.commit()
    print(f"{len(donnees_equipements)} équipements ont été insérés avec succès.")
    
except Exception as e:
    session.rollback()
    print(f"Une erreur est survenue: {e}")
finally:
    session.close()